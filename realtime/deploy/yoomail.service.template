[Unit]
Description=YooMail Realtime Service (IMAP IDLE + WebSocket)
Wants=network-online.target
After=network-online.target mysql.service php8.5-fpm.service

[Service]
Type=simple
User=__PHP_USER__
Group=__PHP_USER__
WorkingDirectory=__NC_ROOT__
ExecStart=/usr/bin/php __NC_ROOT__/apps-extra/yoomail/realtime/server.php start
# systemd manages the process lifecycle; send SIGTERM to stop Workerman gracefully
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=10
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__NC_ROOT__/data __NC_ROOT__/apps-extra/yoomail/realtime

[Install]
WantedBy=multi-user.target
