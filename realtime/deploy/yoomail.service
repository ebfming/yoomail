[Unit]
Description=YooMail Realtime Service (IMAP IDLE + WebSocket)
Wants=network-online.target
After=network-online.target mysql.service php8.5-fpm.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/web/nextcloud
ExecStart=/usr/bin/php /web/nextcloud/apps-extra/yoomail/realtime/server.php start
# systemd manages the process lifecycle; send SIGTERM to stop Workerman gracefully
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=10
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/web/nextcloud/data /web/nextcloud/apps-extra/yoomail/realtime

[Install]
WantedBy=multi-user.target
